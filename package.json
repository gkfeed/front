{
  "name": "gkfeed-front",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:front": "vite --host 0.0.0.0 --port 4200",
    "dev:bff": "tsx watch server/index.ts",
    "build": "npm run typecheck && npm run build:bff && vite build && npm run budget",
    "build:bff": "rm -rf dist-server && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "check": "npm test && npm run lint && npm run build && npm run test:e2e",
    "lint": "eslint .",
    "budget": "node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "preview": "vite preview --host 0.0.0.0 --port 4200"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "i18next": "^26.3.6",
    "linkedom": "^0.18.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "parseuri": "file:server/vendor/parseuri",
    "socket.io-client": "^2.4.0"
  },
  "overrides": {
    "parseuri": "$parseuri"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
